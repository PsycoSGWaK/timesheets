{% extends 'base.html.twig' %}

{% block title %}Jour {{ date|date('d/m/Y') }}{% endblock %}

{% block stylesheets %}
<style>
    main { max-width: 480px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    h1 { font-size: 1.4rem; margin-bottom: .3rem; }
    .subtitle { color: var(--text-secondary); font-size: .9rem; margin-bottom: 1.5rem; }
    label { display: block; font-weight: 600; margin: .9rem 0 .3rem; color: var(--text-primary); }
    .slot-hint { font-size: .8rem; color: var(--text-muted); font-weight: 400; }
    input[type=time] {
        width: 100%; box-sizing: border-box;
        background: var(--surface-card); color: var(--text-primary);
        border: 1px solid var(--gridline); border-radius: 8px;
        padding: .5rem .6rem; font: inherit; font-size: 1rem;
        font-variant-numeric: tabular-nums;
    }
    input[type=time]:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    input[type=time][readonly] {
        background: var(--surface-1); color: var(--text-secondary);
        border-style: dashed;
    }
    button {
        margin-top: 1.2rem; padding: .6rem 1.2rem; border: 0; border-radius: 8px;
        background: var(--accent); color: var(--accent-ink); font: inherit; font-weight: 600; cursor: pointer;
    }
    button:hover { filter: brightness(1.08); }
    .result {
        margin-top: 1.5rem; padding: 1.25rem; border: 1px solid var(--gridline);
        background: var(--surface-card); border-radius: 10px;
    }
    .result .leave {
        font-size: 2rem; font-weight: 700; color: var(--accent);
        font-variant-numeric: tabular-nums; margin-top: .15rem;
    }
    .result ul { margin: 1rem 0 0; padding-left: 1.1rem; color: var(--text-secondary); font-size: .9rem; line-height: 1.6; }
    .back-link { display: inline-block; margin-top: 2rem; font-weight: 600; text-decoration: none; }
</style>
{% endblock %}

{% block body %}
{% set jours = {'1': 'lundi', '2': 'mardi', '3': 'mercredi', '4': 'jeudi', '5': 'vendredi', '6': 'samedi', '7': 'dimanche'} %}
{% set labels = {'matin': 'Matin (prise de poste)', 'midi': 'Midi (départ pause)', 'apres_midi': 'Après-midi (retour pause)', 'soir': 'Soir (fin de journée)'} %}
<main>
    <h1>{{ jours[date|date('N')]|capitalize }} {{ date|date('d/m/Y') }}</h1>
    <p class="subtitle">Les créneaux grisés sont des pointages réels : ils ne se modifient pas ici.</p>

    <form method="post" action="{{ path('day_save', {date: date|date('Y-m-d')}) }}">
        {% for slot in slots %}
            <label for="{{ slot.field }}">{{ labels[slot.field] }}</label>
            <input
                type="time"
                id="{{ slot.field }}"
                name="{{ slot.field }}"
                value="{{ slot.value }}"
                {%- if slot.readonly %} readonly{% endif %}
            >
        {% endfor %}

        <button type="submit">Enregistrer</button>
    </form>

    {% if estimate %}
        <div class="result">
            <div>Tu peux partir à</div>
            <div class="leave">{{ estimate.expectedLeave.toClock }}</div>
            <ul>
                <li>Travail du matin : {{ estimate.morningWorked.value|duree }}</li>
                <li>Pause : {{ estimate.breakDuration.value|duree }}{% if estimate.breakPenalty.value > 0 %}
                    (pénalité de {{ estimate.breakPenalty.value|duree }} pour pause trop courte){% endif %}</li>
                <li>Objectif visé : {{ estimate.objective.value|duree }}</li>
            </ul>
        </div>
    {% endif %}

    <a class="back-link" href="{{ path('week_current') }}">← Voir ma semaine</a>
</main>
{% endblock %}
