<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <script nonce="{{ csp_nonce() }}">
            (function () {
                var stored = localStorage.getItem('theme');
                var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            })();
        </script>
        <title>{% block title %}Timesheets{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        <style>
            :root {
                color-scheme: light;
                --surface-1: #fcfcfb;
                --surface-2: #f9f9f7;
                --surface-card: #ffffff;
                --text-primary: #0b0b0b;
                --text-secondary: #52514e;
                --text-muted: #898781;
                --gridline: #e1e0d9;
                --border: rgba(11, 11, 11, 0.10);
                --accent: #b00d23;
                --accent-ink: #ffffff;
                --status-good: #0ca30c;
                --status-good-bg: #e8f6e8;
                --status-warning: #fab219;
                --status-warning-bg: #fff6e2;
                --status-serious: #ec835a;
                --status-serious-bg: #fdece5;
                --status-critical: #d03b3b;
                --status-critical-bg: #fbe7e7;
            }
            @media (prefers-color-scheme: dark) {
                :root:where(:not([data-theme="light"])) {
                    color-scheme: dark;
                    --surface-1: #1a1a19;
                    --surface-2: #0d0d0d;
                    --surface-card: #232322;
                    --text-primary: #ffffff;
                    --text-secondary: #c3c2b7;
                    --text-muted: #898781;
                    --gridline: #2c2c2a;
                    --border: rgba(255, 255, 255, 0.10);
                    --accent: #e8495f;
                    --accent-ink: #0b0b0b;
                    --status-good: #0ca30c;
                    --status-good-bg: #0f2410;
                    --status-warning: #fab219;
                    --status-warning-bg: #2b2210;
                    --status-serious: #ec835a;
                    --status-serious-bg: #2c1a12;
                    --status-critical: #e66767;
                    --status-critical-bg: #2c1414;
                }
            }
            :root[data-theme="dark"] {
                color-scheme: dark;
                --surface-1: #1a1a19;
                --surface-2: #0d0d0d;
                --surface-card: #232322;
                --text-primary: #ffffff;
                --text-secondary: #c3c2b7;
                --text-muted: #898781;
                --gridline: #2c2c2a;
                --border: rgba(255, 255, 255, 0.10);
                --accent: #e8495f;
                --accent-ink: #0b0b0b;
                --status-good: #0ca30c;
                --status-good-bg: #0f2410;
                --status-warning: #fab219;
                --status-warning-bg: #2b2210;
                --status-serious: #ec835a;
                --status-serious-bg: #2c1a12;
                --status-critical: #e66767;
                --status-critical-bg: #2c1414;
            }

            * { box-sizing: border-box; }
            body {
                font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
                color: var(--text-primary);
                background: var(--surface-2);
                margin: 0;
            }
            a { color: var(--accent); }

            .app-nav {
                display: flex;
                align-items: center;
                gap: 1.5rem;
                padding: .85rem 1.25rem;
                background: var(--surface-1);
                border-bottom: 1px solid var(--gridline);
            }
            .app-nav__brand {
                font-weight: 700;
                color: var(--text-primary);
                text-decoration: none;
                margin-right: auto;
            }
            .app-nav a:not(.app-nav__brand) {
                color: var(--text-secondary);
                text-decoration: none;
                font-size: .92rem;
                font-weight: 600;
                padding: .3rem .1rem;
                border-bottom: 2px solid transparent;
            }
            .app-nav a[aria-current="page"] {
                color: var(--text-primary);
                border-bottom-color: var(--accent);
            }
            .app-nav a:hover { color: var(--text-primary); }

            .theme-toggle {
                position: relative;
                flex: 0 0 auto;
                width: 2.1rem;
                height: 2.1rem;
                border: 1px solid var(--gridline);
                border-radius: 50%;
                background: var(--surface-card);
                color: var(--text-primary);
                display: flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
                padding: 0;
            }
            .theme-toggle:hover { border-color: var(--accent); }
            .theme-toggle__icon {
                position: absolute;
                width: 1.05rem;
                height: 1.05rem;
                transition: opacity .15s ease, transform .15s ease;
            }
            .theme-toggle__icon--moon { opacity: 0; transform: scale(.5) rotate(90deg); }
            :root[data-theme="dark"] .theme-toggle__icon--sun { opacity: 0; transform: scale(.5) rotate(-90deg); }
            :root[data-theme="dark"] .theme-toggle__icon--moon { opacity: 1; transform: scale(1) rotate(0deg); }
        </style>
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app', {nonce: csp_nonce()}) }}{% endblock %}
        {% endblock %}

        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.user %}
        <nav class="app-nav">
            <a class="app-nav__brand" href="{{ path('week_current') }}">Timesheets</a>
            <a href="{{ path('import') }}"{% if app.request.attributes.get('_route') == 'import' %} aria-current="page"{% endif %}>Coller un pointage</a>
            <a href="{{ path('week_current') }}"{% if app.request.attributes.get('_route') starts with 'week' %} aria-current="page"{% endif %}>Ma semaine</a>
            <a href="{{ path('projection') }}"{% if app.request.attributes.get('_route') == 'projection' %} aria-current="page"{% endif %}>Quand partir ?</a>
            <a href="{{ path('balances') }}"{% if app.request.attributes.get('_route') starts with 'balance' %} aria-current="page"{% endif %}>Compteurs</a>
            <a href="{{ path('settings') }}"{% if app.request.attributes.get('_route') starts with 'settings' %} aria-current="page"{% endif %}>Paramétrage</a>
            <a href="{{ path('logout') }}">Déconnexion</a>
            <button type="button" class="theme-toggle" data-controller="theme" data-action="theme#toggle" aria-label="Changer de thème">
                <svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="4"></circle>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                </svg>
                <svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"></path>
                </svg>
            </button>
        </nav>
        {% endif %}
        {% block body %}{% endblock %}
    </body>
</html>
