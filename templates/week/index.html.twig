{% extends 'base.html.twig' %}

{% block title %}Semaine {{ week }} — {{ monday|date('d/m/Y') }}{% endblock %}

{% block stylesheets %}
<style>
    main { max-width: 920px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    .nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; gap: 1rem; }
    .nav a { text-decoration: none; font-weight: 600; font-size: .9rem; white-space: nowrap; }
    h1 { font-size: 1.3rem; margin: 0; text-align: center; }

    .stat-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; margin: 0 0 1.25rem; }
    .stat-tile {
        background: var(--surface-card); border: 1px solid var(--gridline); border-radius: 10px;
        padding: .9rem 1rem;
    }
    .stat-tile__label { font-size: .82rem; color: var(--text-secondary); }
    .stat-tile__value {
        display: block; margin-top: .2rem; font-size: 1.5rem; font-weight: 700;
        font-variant-numeric: tabular-nums; color: var(--text-primary);
    }
    .stat-tile--overtime .stat-tile__value { color: var(--status-serious); }

    .projection {
        margin: 0 0 1.5rem; padding: .9rem 1.1rem; border: 1px solid var(--gridline);
        border-radius: 10px; background: var(--surface-card); font-size: .94rem; color: var(--text-secondary);
    }
    .projection strong { color: var(--accent); font-variant-numeric: tabular-nums; }

    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    th, td { text-align: left; padding: .6rem .6rem; border-bottom: 1px solid var(--gridline); }
    th { color: var(--text-muted); font-weight: 600; font-size: .78rem; text-transform: uppercase; letter-spacing: .02em; }
    td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .muted { color: var(--text-muted); }

    tr.row-critical { background: var(--status-critical-bg); }
    tr.row-serious { background: var(--status-serious-bg); }

    .status-pill {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .85rem; font-weight: 600;
    }
    .status-pill::before {
        content: ""; width: 8px; height: 8px; border-radius: 50%; flex: none;
        background: var(--text-muted);
    }
    .status-good::before { background: var(--status-good); }
    .status-warning::before { background: var(--status-warning); }
    .status-serious::before { background: var(--status-serious); }
    .status-critical::before { background: var(--status-critical); }
    .status-critical, .status-serious { color: var(--text-primary); }

    .back-link { display: inline-block; margin-top: 2rem; font-weight: 600; text-decoration: none; }
</style>
{% endblock %}

{% block body %}
{% set jours = {'1': 'Lun', '2': 'Mar', '3': 'Mer', '4': 'Jeu', '5': 'Ven', '6': 'Sam', '7': 'Dim'} %}
{% set statusTone = {
    'aligned': 'good',
    'divergent': 'serious',
    'employer_zero': 'critical',
    'pending': 'muted',
    'no_reading': 'muted',
} %}
<main>
    <div class="nav">
        <a href="{{ path('week', {year: previous.year, week: previous.week}) }}">← Semaine {{ previous.week }}</a>
        <h1>Semaine {{ week }} — du {{ monday|date('d/m') }} au {{ sunday|date('d/m/Y') }}</h1>
        <a href="{{ path('week', {year: next.year, week: next.week}) }}">Semaine {{ next.week }} →</a>
    </div>

    <div class="stat-tiles">
        <div class="stat-tile">
            <span class="stat-tile__label">Travaillé</span>
            <span class="stat-tile__value">{{ workWeek.weekFact.workedMinutes.value|duree }}</span>
        </div>
        <div class="stat-tile">
            <span class="stat-tile__label">RTT acquis</span>
            <span class="stat-tile__value">{{ workWeek.weekFact.rttAcquired.value|duree }}</span>
        </div>
        <div class="stat-tile{{ workWeek.weekFact.overtimeMinutes.value > 0 ? ' stat-tile--overtime' : '' }}">
            <span class="stat-tile__label">Heures sup.</span>
            <span class="stat-tile__value">{{ workWeek.weekFact.overtimeMinutes.value|duree }}</span>
        </div>
    </div>

    <div class="projection">
        {% if projection.objectiveReached %}
            Objectif de {{ projection.objective.value|duree }} atteint.
            {% if projection.overtimeSoFar.value > 0 %}
                <strong>{{ projection.overtimeSoFar.value|duree }}</strong> en heures supplémentaires.
            {% endif %}
        {% elseif projection.remainingWorkingDays > 0 %}
            Il reste <strong>{{ projection.remainingToObjective.value|duree }}</strong>
            avant {{ projection.objective.value|duree }},
            soit <strong>{{ projection.targetPerRemainingDay.value|duree }}</strong> par jour
            sur {{ projection.remainingWorkingDays }} jour(s) restant(s).
        {% else %}
            Il manque <strong>{{ projection.remainingToObjective.value|duree }}</strong>
            pour atteindre {{ projection.objective.value|duree }}, sans jour ouvré restant cette semaine.
        {% endif %}
    </div>

    <table>
        <thead>
            <tr>
                <th>Jour</th>
                <th class="num">Nous</th>
                <th class="num">ADP</th>
                <th class="num">Écart</th>
                <th>Rapprochement</th>
            </tr>
        </thead>
        <tbody>
            {% for day in workWeek.days %}
                {% set reco = day.reconciliation %}
                {% set tone = statusTone[reco.status.value] ?? 'muted' %}
                <tr class="{{ reco.needsAttention ? 'row-' ~ tone : '' }}">
                    <td>{{ jours[day.date|date('N')] }} {{ day.date|date('d/m') }}</td>
                    <td class="num">{{ day.dayFact.workedMinutes.value|duree }}</td>
                    <td class="num">
                        {%- if day.employerReading is not null -%}
                            {{ day.employerReading.value|duree }}
                        {%- else -%}
                            <span class="muted">—</span>
                        {%- endif -%}
                    </td>
                    <td class="num">
                        {%- if reco.delta is not null -%}
                            {{ reco.delta.value|duree }}
                        {%- else -%}
                            <span class="muted">—</span>
                        {%- endif -%}
                    </td>
                    <td>
                        <span class="status-pill status-{{ tone }}">{{ reco.status.label }}</span>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a class="back-link" href="{{ path('import') }}">← Coller un nouveau pointage</a>
</main>
{% endblock %}
