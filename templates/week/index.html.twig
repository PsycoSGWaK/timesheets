{% extends 'base.html.twig' %}

{% block title %}Semaine {{ week }} — {{ monday|date('d/m/Y') }}{% endblock %}

{% block stylesheets %}
<style>
    main { max-width: 920px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    .nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem; gap: 1rem; }
    .nav a { text-decoration: none; font-weight: 600; font-size: .9rem; white-space: nowrap; }
    h1 { font-size: 1.3rem; margin: 0; text-align: center; }

    .week-picker {
        display: flex; justify-content: center; align-items: center; gap: .4rem;
        margin-top: .5rem;
    }
    .week-picker input {
        background: var(--surface-card); color: var(--text-primary);
        border: 1px solid var(--gridline); border-radius: 6px;
        font: inherit; font-size: .82rem; padding: .25rem .4rem;
    }
    .week-picker button {
        border: 1px solid var(--gridline); border-radius: 6px; background: var(--surface-card);
        color: var(--text-secondary); font: inherit; font-size: .82rem; padding: .25rem .6rem; cursor: pointer;
    }
    .week-picker button:hover { color: var(--text-primary); border-color: var(--accent); }

    .stat-tiles { display: grid; grid-template-columns: repeat(3, 1fr); gap: .9rem; margin: 0 0 1.25rem; }
    .stat-tile {
        background: var(--surface-card); border: 1px solid var(--gridline); border-radius: 10px;
        padding: .9rem 1rem;
    }
    .stat-tile__label { font-size: .82rem; color: var(--text-secondary); }
    .stat-tile__value {
        display: block; margin-top: .2rem; font-size: 1.5rem; font-weight: 700;
        font-variant-numeric: tabular-nums; color: var(--text-primary);
    }
    .stat-tile--overtime .stat-tile__value { color: var(--status-serious); }

    .projection {
        margin: 0 0 1.5rem; padding: .9rem 1.1rem; border: 1px solid var(--gridline);
        border-radius: 10px; background: var(--surface-card); font-size: .94rem; color: var(--text-secondary);
    }
    .projection strong { color: var(--accent); font-variant-numeric: tabular-nums; }
    .projection-target { margin-bottom: .6rem; }
    .projection-target__label { display: block; font-weight: 600; color: var(--text-primary); margin-bottom: .15rem; }

    table { width: 100%; border-collapse: collapse; font-size: .92rem; }
    th, td { text-align: left; padding: .6rem .6rem; border-bottom: 1px solid var(--gridline); }
    th { color: var(--text-muted); font-weight: 600; font-size: .78rem; text-transform: uppercase; letter-spacing: .02em; }
    td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .muted { color: var(--text-muted); }

    tr.row-critical { background: var(--status-critical-bg); }
    tr.row-serious { background: var(--status-serious-bg); }

    .status-pill {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .85rem; font-weight: 600;
    }
    .status-pill::before {
        content: ""; width: 8px; height: 8px; border-radius: 50%; flex: none;
        background: var(--text-muted);
    }
    .status-good::before { background: var(--status-good); }
    .status-warning::before { background: var(--status-warning); }
    .status-serious::before { background: var(--status-serious); }
    .status-critical::before { background: var(--status-critical); }
    .status-critical, .status-serious { color: var(--text-primary); }

    .back-link { display: inline-block; margin-top: 2rem; font-weight: 600; text-decoration: none; }

    .event-badge {
        display: inline-flex; align-items: center; gap: .4rem;
        font-size: .85rem; color: var(--text-primary);
    }
    .event-badge form { display: inline; }
    .event-badge button {
        border: 0; background: none; color: var(--text-muted); cursor: pointer;
        font: inherit; padding: 0; line-height: 1;
    }
    .event-badge button:hover { color: var(--status-critical); }
    .event-badge--repos { color: var(--text-muted); font-style: italic; }
    .event-form { display: flex; gap: .3rem; align-items: center; }
    .event-form select {
        background: var(--surface-card); color: var(--text-primary);
        border: 1px solid var(--gridline); border-radius: 6px;
        font: inherit; font-size: .82rem; padding: .2rem .3rem;
    }
    .event-form button {
        border: 0; border-radius: 6px; background: var(--surface-card);
        border: 1px solid var(--gridline); color: var(--text-secondary);
        font: inherit; font-size: .82rem; padding: .2rem .5rem; cursor: pointer;
    }
    .event-form button:hover { color: var(--text-primary); border-color: var(--accent); }

    .error { background: var(--status-critical-bg); color: var(--status-critical);
        padding: .75rem 1rem; border-radius: 8px; font-weight: 600; margin-bottom: 1rem; }
    .stat-tile__action { margin-top: .5rem; }
    .stat-tile__action button {
        border: 1px solid var(--gridline); border-radius: 6px; background: var(--surface-1);
        color: var(--text-secondary); font: inherit; font-size: .78rem; padding: .2rem .5rem; cursor: pointer;
    }
    .stat-tile__action button:hover { color: var(--text-primary); border-color: var(--accent); }
    .overtime-form {
        margin: -.5rem 0 1.5rem; padding: .9rem 1.1rem; border: 1px solid var(--gridline);
        border-radius: 10px; background: var(--surface-card); font-size: .9rem;
    }
    .overtime-form .fields { display: flex; gap: .6rem; flex-wrap: wrap; margin: .6rem 0; }
    .overtime-form label { display: block; font-size: .78rem; color: var(--text-secondary); margin-bottom: .2rem; }
    .overtime-form input[type=time], .overtime-form input[type=text] {
        background: var(--surface-1); color: var(--text-primary);
        border: 1px solid var(--gridline); border-radius: 6px; padding: .3rem .4rem; font: inherit;
    }
    .overtime-form input[type=text] { width: 100%; box-sizing: border-box; margin-top: .4rem; }
    .overtime-form button {
        margin-top: .6rem; border: 0; border-radius: 6px; background: var(--accent);
        color: var(--accent-ink); font: inherit; font-weight: 600; padding: .35rem .8rem; cursor: pointer;
    }
</style>
{% endblock %}

{% block body %}
{% set jours = {'1': 'Lun', '2': 'Mar', '3': 'Mer', '4': 'Jeu', '5': 'Ven', '6': 'Sam', '7': 'Dim'} %}
{% set statusTone = {
    'aligned': 'good',
    'divergent': 'serious',
    'employer_zero': 'critical',
    'pending': 'muted',
    'no_reading': 'muted',
    'repos': 'muted',
} %}
<main>
    {% for message in app.flashes('error') %}
        <p class="error">{{ message }}</p>
    {% endfor %}

    <div class="nav">
        <a href="{{ path('week', {year: previous.year, week: previous.week}) }}">← Semaine {{ previous.week }}</a>
        <div>
            <h1>Semaine {{ week }} — du {{ monday|date('d/m') }} au {{ sunday|date('d/m/Y') }}</h1>
            <form class="week-picker" method="get" action="{{ path('week_goto') }}">
                <input type="week" name="semaine" value="{{ pickerValue }}">
                <button type="submit">Aller</button>
            </form>
        </div>
        <a href="{{ path('week', {year: next.year, week: next.week}) }}">Semaine {{ next.week }} →</a>
    </div>

    <div class="stat-tiles">
        <div class="stat-tile">
            <span class="stat-tile__label">Travaillé</span>
            <span class="stat-tile__value">{{ workWeek.weekFact.workedMinutes.value|duree }}</span>
        </div>
        <div class="stat-tile">
            <span class="stat-tile__label">RTT acquis</span>
            <span class="stat-tile__value">{{ workWeek.weekFact.rttAcquired.value|duree }}</span>
            {% if workWeek.weekFact.rttAcquired.value > 0 %}
                <form class="stat-tile__action" method="post" action="{{ path('balance_credit_rtt', {year: monday|date('o'), week: week}) }}">
                    <button type="submit">Créditer ce RTT</button>
                </form>
            {% endif %}
        </div>
        <div class="stat-tile{{ workWeek.weekFact.overtimeMinutes.value > 0 ? ' stat-tile--overtime' : '' }}">
            <span class="stat-tile__label">Heures sup.</span>
            <span class="stat-tile__value">{{ workWeek.weekFact.overtimeMinutes.value|duree }}</span>
        </div>
    </div>

    {% if workWeek.weekFact.overtimeMinutes.value > 0 %}
        <div class="overtime-form">
            <strong>Répartir les heures supplémentaires</strong>
            <form method="post" action="{{ path('balance_allocate_overtime', {year: monday|date('o'), week: week}) }}">
                <div class="fields">
                    <div>
                        <label for="recuperation">Récupération</label>
                        <input type="time" id="recuperation" name="recuperation" value="00:00">
                    </div>
                    <div>
                        <label for="variable">Variable</label>
                        <input type="time" id="variable" name="variable" value="00:00">
                    </div>
                    <div>
                        <label for="paiement">Paiement</label>
                        <input type="time" id="paiement" name="paiement" value="00:00">
                    </div>
                </div>
                <label for="motif">Motif</label>
                <input type="text" id="motif" name="motif" placeholder="Facultatif">
                <div><button type="submit">Répartir</button></div>
            </form>
        </div>
    {% endif %}

    {% for target in [
        {modifier: 'reference', label: 'Vers ' ~ projectionReference.objective.value|duree ~ ' (RTT)', projection: projectionReference},
        {modifier: 'bascule', label: 'Vers ' ~ projection.objective.value|duree ~ ' (bascule HS)', projection: projection},
    ] %}
        {% set p = target.projection %}
        <div class="projection projection-target projection-target--{{ target.modifier }}">
            <span class="projection-target__label">{{ target.label }}</span>
            {% if p.objectiveReached %}
                Objectif atteint.
                {% if p.overtimeSoFar.value > 0 %}
                    <strong>{{ p.overtimeSoFar.value|duree }}</strong> au-delà.
                {% endif %}
            {% elseif p.remainingWorkingDays > 0 %}
                Il reste <strong>{{ p.remainingToObjective.value|duree }}</strong>,
                soit <strong>{{ p.targetPerRemainingDay.value|duree }}</strong> par jour
                sur {{ p.remainingWorkingDays }} jour(s) restant(s).
            {% else %}
                Il manque <strong>{{ p.remainingToObjective.value|duree }}</strong>, sans jour ouvré restant cette semaine.
            {% endif %}
        </div>
    {% endfor %}

    <table>
        <thead>
            <tr>
                <th>Jour</th>
                <th>Événement</th>
                <th class="num">Nous</th>
                <th class="num">ADP</th>
                <th class="num">Écart</th>
                <th>Rapprochement</th>
            </tr>
        </thead>
        <tbody>
            {% for day in workWeek.days %}
                {% set reco = day.reconciliation %}
                {% set tone = statusTone[reco.status.value] ?? 'muted' %}
                <tr class="{{ reco.needsAttention ? 'row-' ~ tone : '' }}">
                    <td><a href="{{ path('day', {date: day.date|date('Y-m-d')}) }}">{{ jours[day.date|date('N')] }} {{ day.date|date('d/m') }}</a></td>
                    <td>
                        {% if reco.status.value == 'repos' %}
                            <span class="event-badge event-badge--repos">Repos</span>
                        {% elseif day.event %}
                            <span class="event-badge">
                                {{ day.event.code.label }}{% if day.event.half %} — {{ day.event.half.label }}{% endif %}
                                <form method="post" action="{{ path('day_event_remove') }}">
                                    <input type="hidden" name="date" value="{{ day.date|date('Y-m-d') }}">
                                    <button type="submit" title="Retirer">×</button>
                                </form>
                            </span>
                        {% else %}
                            <form class="event-form" method="post" action="{{ path('day_event_declare') }}" data-controller="day-event">
                                <input type="hidden" name="date" value="{{ day.date|date('Y-m-d') }}">
                                <select name="code" data-action="change->day-event#update">
                                    <option value="TT">Télétravail</option>
                                    <option value="CP">Congé payé</option>
                                    <option value="CA">Congé ancienneté</option>
                                    <option value="RTT">RTT posé</option>
                                    <option value="JF">Jour férié</option>
                                </select>
                                <select name="portion" data-action="change->day-event#update">
                                    <option value="full">1 j</option>
                                    <option value="half">0,5 j</option>
                                </select>
                                <select name="half" data-day-event-target="half" hidden>
                                    <option value="matin">Matin</option>
                                    <option value="apres_midi">Après-midi</option>
                                </select>
                                <button type="submit">Ajouter</button>
                            </form>
                        {% endif %}
                    </td>
                    <td class="num">{{ day.dayFact.workedMinutes.value|duree }}</td>
                    <td class="num">
                        {%- if day.employerReading is not null -%}
                            {{ day.employerReading.value|duree }}
                        {%- else -%}
                            <span class="muted">—</span>
                        {%- endif -%}
                    </td>
                    <td class="num">
                        {%- if reco.delta is not null -%}
                            {{ reco.delta.value|duree }}
                        {%- else -%}
                            <span class="muted">—</span>
                        {%- endif -%}
                    </td>
                    <td>
                        <span class="status-pill status-{{ tone }}">{{ reco.status.label }}</span>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <a class="back-link" href="{{ path('import') }}">← Coller un nouveau pointage</a>
</main>
{% endblock %}
