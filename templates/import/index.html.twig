{% extends 'base.html.twig' %}

{% block title %}Coller le pointage ADP{% endblock %}

{% block stylesheets %}
<style data-turbo-track="reload">
    main { max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    h1 { font-size: 1.5rem; margin-bottom: 1.5rem; }
    h2 { font-size: 1.1rem; margin-top: 2.5rem; color: var(--text-primary); }
    label { display: block; font-weight: 600; margin-bottom: .35rem; color: var(--text-primary); }
    input[type=number], textarea {
        background: var(--surface-card);
        color: var(--text-primary);
        border: 1px solid var(--gridline);
        border-radius: 8px;
        font: inherit;
    }
    input[type=number] { padding: .45rem .6rem; width: 8rem; }
    textarea {
        width: 100%;
        box-sizing: border-box;
        margin-top: .75rem;
        padding: .75rem;
        font-family: ui-monospace, "SF Mono", Consolas, monospace;
        font-size: .88rem;
        resize: vertical;
    }
    input[type=number]:focus, textarea:focus {
        outline: 2px solid var(--accent);
        outline-offset: 1px;
    }
    button {
        margin-top: 1rem;
        padding: .6rem 1.2rem;
        border: 0;
        border-radius: 8px;
        background: var(--accent);
        color: var(--accent-ink);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }
    button:hover { filter: brightness(1.08); }
    table { width: 100%; border-collapse: collapse; margin-top: .75rem; font-size: .92rem; }
    th, td { text-align: left; padding: .55rem .6rem; border-bottom: 1px solid var(--gridline); }
    th { color: var(--text-muted); font-weight: 600; font-size: .82rem; text-transform: uppercase; letter-spacing: .02em; }
    td { font-variant-numeric: tabular-nums; }
    .error {
        background: var(--status-critical-bg); color: var(--status-critical);
        padding: .75rem 1rem; border-radius: 8px; font-weight: 600;
    }
    .result {
        background: var(--status-good-bg); color: var(--status-good);
        padding: .75rem 1rem; border-radius: 8px; font-weight: 600;
    }
    .result strong, .error strong { font-weight: 700; }
    .muted { color: var(--text-muted); }
</style>
{% endblock %}

{% block body %}
<main>
    <h1>Coller le pointage ADP</h1>

    {% if error %}
        <p class="error">Texte illisible : {{ error }}</p>
    {% endif %}

    {% if result %}
        <p class="result">
            Import effectué :
            <strong>{{ result.punchesCreated }}</strong> pointage(s) créé(s),
            <strong>{{ result.readingsRecorded }}</strong> relevé(s) ADP enregistré(s){% if result.provisionalSuperseded %},
            {{ result.provisionalSuperseded }} prévisionnel(s) remplacé(s) par du réel{% endif %}.
        </p>
    {% endif %}

    <form method="post" action="{{ path('import') }}" data-turbo="false">
        <label for="year">Année</label>
        <input type="number" id="year" name="year" value="{{ year }}">

        <label for="payload" style="margin-top:1rem">Texte copié depuis la Fiche de présence MonADP</label>
        <textarea id="payload" name="payload" rows="14"
                  placeholder="Colle ici la sélection copiée depuis l'écran ADP…">{{ payload }}</textarea>

        <div>
            <button type="submit" name="action" value="apercu">Aperçu</button>
        </div>
    </form>

    {% if week %}
        <h2>Ce qui a été compris{% if not result %} <span class="muted">(aperçu)</span>{% endif %}</h2>
        {% if week.days is empty %}
            <p class="muted">Aucun jour détecté dans le texte collé.</p>
        {% else %}
            <table>
                <thead>
                    <tr><th>Jour</th><th>Total ADP</th><th>Pointages</th><th>Événement</th></tr>
                </thead>
                <tbody>
                    {% for day in week.days %}
                        <tr>
                            <td>{{ day.date|date('d/m') }}</td>
                            <td>
                                {%- if day.adpTotal is not null -%}
                                    {{ (day.adpTotal.value // 60) }}h{{ '%02d'|format(day.adpTotal.value % 60) }}
                                {%- else -%}
                                    <span class="muted">—</span>
                                {%- endif -%}
                            </td>
                            <td>{{ day.punchCount }}</td>
                            <td class="muted">{{ day.eventLabel ?? '' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if not result %}
                <form method="post" action="{{ path('import') }}" data-turbo="false">
                    <input type="hidden" name="payload" value="{{ payload }}">
                    <input type="hidden" name="year" value="{{ year }}">
                    <button type="submit" name="action" value="importer">Confirmer l'import</button>
                </form>
            {% endif %}
        {% endif %}
    {% endif %}
</main>
{% endblock %}
