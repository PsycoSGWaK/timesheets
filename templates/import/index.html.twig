{% extends 'base.html.twig' %}

{% block title %}Coller le pointage ADP{% endblock %}

{% block stylesheets %}
<style>
    :root { --border: #d0d0d7; --muted: #6b6b76; --accent: #2f5fdc; --bg-soft: #f6f6f9; }
    body { font-family: system-ui, sans-serif; color: #1a1a1f; margin: 0; background: #fff; }
    main { max-width: 820px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
    h1 { font-size: 1.5rem; }
    h2 { font-size: 1.15rem; margin-top: 2rem; }
    label { display: block; font-weight: 600; margin-bottom: .35rem; }
    input[type=number] { padding: .4rem; border: 1px solid var(--border); border-radius: 6px; width: 8rem; }
    textarea { width: 100%; box-sizing: border-box; margin-top: .75rem; padding: .75rem;
        border: 1px solid var(--border); border-radius: 8px; font-family: ui-monospace, monospace; font-size: .9rem; }
    button { margin-top: .9rem; padding: .55rem 1.1rem; border: 0; border-radius: 8px;
        background: var(--accent); color: #fff; font-weight: 600; cursor: pointer; }
    button.secondary { background: #e7e7ee; color: #1a1a1f; }
    table { width: 100%; border-collapse: collapse; margin-top: .75rem; font-size: .92rem; }
    th, td { text-align: left; padding: .5rem .6rem; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 600; }
    .error { background: #fdecec; color: #a12020; padding: .75rem 1rem; border-radius: 8px; }
    .result { background: #eaf6ec; color: #1c5a2a; padding: .75rem 1rem; border-radius: 8px; }
    .muted { color: var(--muted); }
</style>
{% endblock %}

{% block body %}
<main>
    <h1>Coller le pointage ADP</h1>

    {% if error %}
        <p class="error">Texte illisible : {{ error }}</p>
    {% endif %}

    {% if result %}
        <p class="result">
            Import effectué :
            <strong>{{ result.punchesCreated }}</strong> pointage(s) créé(s),
            <strong>{{ result.readingsRecorded }}</strong> relevé(s) ADP enregistré(s){% if result.provisionalSuperseded %},
            {{ result.provisionalSuperseded }} prévisionnel(s) remplacé(s) par du réel{% endif %}.
        </p>
    {% endif %}

    <form method="post" action="{{ path('import') }}">
        <label for="year">Année</label>
        <input type="number" id="year" name="year" value="{{ year }}">

        <label for="payload" style="margin-top:1rem">Texte copié depuis la Fiche de présence MonADP</label>
        <textarea id="payload" name="payload" rows="14"
                  placeholder="Colle ici la sélection copiée depuis l'écran ADP…">{{ payload }}</textarea>

        <div>
            <button type="submit" name="action" value="apercu">Aperçu</button>
        </div>
    </form>

    {% if week %}
        <h2>Ce qui a été compris{% if not result %} <span class="muted">(aperçu)</span>{% endif %}</h2>
        {% if week.days is empty %}
            <p class="muted">Aucun jour détecté dans le texte collé.</p>
        {% else %}
            <table>
                <thead>
                    <tr><th>Jour</th><th>Total ADP</th><th>Pointages</th><th>Événement</th></tr>
                </thead>
                <tbody>
                    {% for day in week.days %}
                        <tr>
                            <td>{{ day.date|date('d/m') }}</td>
                            <td>
                                {%- if day.adpTotal is not null -%}
                                    {{ (day.adpTotal.value // 60) }}h{{ '%02d'|format(day.adpTotal.value % 60) }}
                                {%- else -%}
                                    <span class="muted">—</span>
                                {%- endif -%}
                            </td>
                            <td>{{ day.punchCount }}</td>
                            <td class="muted">{{ day.eventLabel ?? '' }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% if not result %}
                <form method="post" action="{{ path('import') }}">
                    <input type="hidden" name="payload" value="{{ payload }}">
                    <input type="hidden" name="year" value="{{ year }}">
                    <button type="submit" name="action" value="importer">Confirmer l'import</button>
                </form>
            {% endif %}
        {% endif %}
    {% endif %}
</main>
{% endblock %}
